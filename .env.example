# ORCA - Marine Intelligence System Configuration

# AI Providers
ANTHROPIC_API_KEY=

# Public Marine Data Credentials (Optional - public ERDDAP fallbacks are active by default)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
NASA_OCEANCOLOR_BASE_URL=https://oceancolor.gsfc.nasa.gov

# NOAA ERDDAP Endpoints (Live verified endpoints)
ERDDAP_OISST_URL=https://coastwatch.pfeg.noaa.gov/erddap/griddap/ncdcOisst21Agg.json
ERDDAP_CHLA_URL=https://coastwatch.pfeg.noaa.gov/erddap/griddap/nesdisVHNnoaaSNPPnoaa20NRTchlaGapfilledDaily.json
ERDDAP_CHLA_OPTICAL_URL=https://coastwatch.pfeg.noaa.gov/erddap/griddap/nesdisVHNnoaa20chlaDaily.json

# Feature Flags
ENABLE_ADVISORY_AGENT=true

# Server & Cache
CACHE_TTL_SECONDS=3600
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
